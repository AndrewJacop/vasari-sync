{
  "name": "vasari-sync",
  "version": "0.1.0",
  "description": "Sync non-VCS project files (.env, secrets, local config) to storage you already own",
  "bin": {
    "vsync": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@inquirer/prompts": "^8.5.2",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "diff": "^5.2.2",
    "ssh2-sftp-client": "^12.1.1",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^26.2.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
